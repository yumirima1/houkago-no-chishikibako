{
  "name": "kousatsu-bako",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "start:local": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:kousatsu": "tsx --test tests/kousatsu/*.test.ts",
    "kousatsu": "tsx scripts/kousatsu.ts",
    "kousatsu:worker": "tsx scripts/kousatsu-worker.ts",
    "kousatsu:backend": "tsx scripts/kousatsu-backend.ts",
    "episode:generate": "tsx scripts/generate-script.ts",
    "episode:review": "tsx scripts/review-script.ts",
    "episode:skeleton": "tsx scripts/generate-conversation-skeleton.ts",
    "episode:audio": "tsx scripts/generate-audio.ts",
    "episode:audio:preview": "tsx scripts/generate-audio.ts --preview",
    "episode:audio:clean": "tsx scripts/clean-audio.ts --episodes --previews",
    "episode:audio:cache:clear": "tsx scripts/clean-audio.ts --cache",
    "episode:build": "tsx scripts/build-episode.ts",
    "episode:draft": "tsx scripts/generate-draft-script.ts",
    "episode:seed": "tsx scripts/generate-episode-seed.ts",
    "episode:seed:legacy": "tsx scripts/seed-episodes.ts",
    "episode:pipeline": "tsx scripts/generate-script.ts && tsx scripts/review-script.ts && tsx scripts/generate-audio.ts && tsx scripts/build-episode.ts",
    "episode:publish": "tsx scripts/generate-script.ts && tsx scripts/review-script.ts && tsx scripts/generate-audio.ts && tsx scripts/build-episode.ts",
    "episode:weekly": "tsx scripts/weekly-episode.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.14",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "robots-parser": "3.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lamejs": "^1.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
